meta {
  name: 02 - SignUp Owner
  type: http
  seq: 2
}

script:pre-request {
  const rand = Math.random().toString(36).substring(2, 10);
  bru.setVar("owner_username", "own_" + rand);
  bru.setVar("owner_email", "own_" + rand + "@test.com");
}

post {
  url: {{api-url}}/api/Auth/signup
  body: json
  auth: inherit
}

body:json {
  {
    "Username": "{{owner_username}}",
    "Password": "OwnerPass123!",
    "Email": "{{owner_email}}"
  }
}

script:post-response {
  const data = res.getBody();
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("Token recibido", function() { expect(data).to.have.property("token"); });
  test("ID de usuario", function() { expect(data.user).to.have.property("id"); });
  test("Rol USER", function() { expect(data.user.role).to.equal("USER"); });
  if (data.user && data.user.id) bru.setEnvVar("owner_user_id", data.user.id);
  if (data.user && data.user.username) bru.setEnvVar("owner_username", data.user.username);
  bru.setEnvVar("owner_password", "OwnerPass123!");
}

meta {
  name: 03 - GiveRole Owner
  type: http
  seq: 3
}

post {
  url: {{api-url}}/api/User/{{owner_user_id}}/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_admin}}
}

body:json {
  "OWNER"
}

script:post-response {
  test("Status 204", function() { expect(res.getStatus()).to.equal(204); });
}

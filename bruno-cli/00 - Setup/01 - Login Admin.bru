meta {
  name: 01 - Login Admin
  type: http
  seq: 1
}

post {
  url: {{api-url}}/api/Auth/signin
  body: json
  auth: inherit
}

body:json {
  {
    "Username": "admin_encordados",
    "Password": "admin123"
  }
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Token recibido", function() { expect(data).to.have.property("token"); });
  test("Datos de usuario", function() { expect(data.user).to.have.property("id"); });
  test("Rol ADMIN", function() { expect(data.user.role).to.equal("ADMIN"); });
  if (data.token) bru.setEnvVar("token_admin", data.token);
}

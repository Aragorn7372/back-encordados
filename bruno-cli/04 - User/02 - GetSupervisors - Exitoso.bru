meta {
  name: 02 - GetSupervisors - Exitoso
  type: http
  seq: 2
}

get {
  url: {{api-url}}/api/User/supervisors
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_owner}}
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Es pagina", function() { expect(data).to.have.property("content"); });
  test("Solo supervisores", function() {
    data.content.forEach(u => expect(u.role).to.equal("SUPERVISOR"));
  });
}

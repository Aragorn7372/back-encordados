meta {
  name: 18 - AddBonos - Cantidad invalida
  type: http
  seq: 18
}

post {
  url: {{api-url}}/api/User/{{tmp2_user_id}}/bonos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_owner}}
}

body:json {
  -1
}

script:post-response {
  const data = res.getBody();
  test("Status 400", function() { expect(res.getStatus()).to.equal(400); });
  test("Mensaje de error", function() { expect(data).to.have.property("message"); });
}

meta {
  name: 03 - GetEncorders - Exitoso
  type: http
  seq: 3
}

get {
  url: {{api-url}}/api/User/encorders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_owner}}
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Es pagina", function() { expect(data).to.have.property("content"); });
  test("Solo encorders", function() {
    data.content.forEach(u => expect(u.role).to.equal("ENCORDER"));
  });
}

meta {
  name: 01 - Exitoso
  type: http
  seq: 1
}

post {
  url: {{api-url}}/api/Auth/signin
  body: json
  auth: inherit
}

body:json {
  {
    "Username": "{{test_username}}",
    "Password": "{{test_password}}"
  }
}

script:post-response {
  const data = res.getBody();
  test("Status 200 OK", function() { expect(res.getStatus()).to.equal(200); });
  test("Token JWT recibido", function() { expect(data).to.have.property("token"); });
  test("Username coincide", function() { expect(data.user.username).to.equal(bru.getEnvVar("test_username")); });
  if (data.token) bru.setEnvVar("test_token", data.token);
}

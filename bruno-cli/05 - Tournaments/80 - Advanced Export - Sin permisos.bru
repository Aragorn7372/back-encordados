meta {
  name: 80 - Advanced Export - Sin permisos
  type: http
  seq: 80
}

get {
  url: {{api-url}}/api/excel/advanced/export?tournamentId={{tournament_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_encorder}}
}

script:post-response {
  test("Status 403", function() { expect(res.getStatus()).to.equal(403); });
}

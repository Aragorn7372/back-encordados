meta {
  name: 32 - Create Material - Sin auth
  type: http
  seq: 31
}

script:pre-request {
  var tid = bru.getEnvVar("tournament_id");
  req.setBody("Marca=Test&Modelo=SinAuth&Stock=1&Precio=1.00&Type=Grip&TournamentId=" + tid);
  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
}

post {
  url: {{api-url}}/api/Materials
  body: none
  auth: inherit
}

script:post-response {
  test("Status 401", function() { expect(res.getStatus()).to.equal(401); });
}

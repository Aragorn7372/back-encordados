meta {
  name: 52 - Update - No encontrado
  type: http
  seq: 52
}

script:pre-request {
  req.setBody("Marca=Test&Modelo=NoExiste&Stock=1&Precio=1.00&StringFormat=Set&StringsType=Polyester&Calibre=1.20");
  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
}

put {
  url: {{api-url}}/api/Cuerdas/99999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_t_owner}}
}

script:post-response {
  const data = res.getBody();
  test("Status 404", function() { expect(res.getStatus()).to.equal(404); });
  test("Mensaje de error", function() { expect(data).to.have.property("message"); });
}

meta {
  name: 43 - GetById - Despues de borrar
  type: http
  seq: 42
}

get {
  url: {{api-url}}/api/Materials/{{material_a_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_t_owner}}
}

script:post-response {
  const data = res.getBody();
  test("Status 404", function() { expect(res.getStatus()).to.equal(404); });
  test("Mensaje de error", function() { expect(data).to.have.property("message"); });
}

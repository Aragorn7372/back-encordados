meta {
  name: 77 - Export - Sin permisos
  type: http
  seq: 77
}

get {
  url: {{api-url}}/api/excel/export/{{tournament_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_encorder}}
}

script:post-response {
  const data = res.getBody();
  test("Status 403", function() { expect(res.getStatus()).to.equal(403); });
  test("Mensaje de error", function() { expect(data).to.have.property("message"); });
}
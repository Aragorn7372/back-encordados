meta {
  name: 69 - Update - No encontrado
  type: http
  seq: 69
}

put {
  url: {{api-url}}/api/Purchased/99999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_encorder}}
}

body:json {
  {
    "Machine": "TestMachine"
  }
}

script:post-response {
  const data = res.getBody();
  test("Status 404", function() { expect(res.getStatus()).to.equal(404); });
  test("Mensaje de error", function() { expect(data).to.have.property("error"); });
}

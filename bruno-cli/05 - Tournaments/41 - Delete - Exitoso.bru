meta {
  name: 41 - Delete - Exitoso
  type: http
  seq: 40
}

delete {
  url: {{api-url}}/api/Materials/{{material_a_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_t_owner}}
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Mensaje eliminacion", function() { expect(data).to.have.property("message"); });
}

meta {
  name: 21 - RemoveSupervisor - Exitoso
  type: http
  seq: 24
}

patch {
  url: {{api-url}}/api/Tournaments/remove-supervisor
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_t_owner}}
}

body:json {
  {
    "TournamentId": "{{tournament_id}}",
    "SupervisorId": "{{sup_t_user_id}}"
  }
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Supervisor removido", function() { expect(data).to.have.property("supevisors"); });
}

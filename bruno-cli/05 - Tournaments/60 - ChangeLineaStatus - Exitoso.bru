meta {
  name: 60 - ChangeLineaStatus - Exitoso
  type: http
  seq: 60
}

patch {
  url: {{api-url}}/api/Purchased/lineas/{{linea_a_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_encorder}}
}

body:json {
  "COMPLETED"
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Status COMPLETED", function() { expect(data.status).to.equal("COMPLETED"); });
}

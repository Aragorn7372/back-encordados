meta {
  name: 03 - Login Supervisor
  type: http
  seq: 3
}

post {
  url: {{api-url}}/api/Auth/signin
  body: json
  auth: inherit
}

body:json {
  {
    "Username": "{{sup_t_username}}",
    "Password": "{{sup_t_password}}"
  }
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Token recibido", function() { expect(data).to.have.property("token"); });
  test("Rol SUPERVISOR", function() { expect(data.user.role).to.equal("SUPERVISOR"); });
  if (data.token) bru.setEnvVar("token_supervisor", data.token);
}

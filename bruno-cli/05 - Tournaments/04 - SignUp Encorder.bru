meta {
  name: 04 - SignUp Encorder
  type: http
  seq: 4
}

script:pre-request {
  const rand = Math.random().toString(36).substring(2, 10);
  bru.setVar("enc_t_username", "enc_" + rand);
  bru.setVar("enc_t_email", "enc_" + rand + "@test.com");
}

post {
  url: {{api-url}}/api/Auth/signup
  body: json
  auth: inherit
}

body:json {
  {
    "Username": "{{enc_t_username}}",
    "Password": "EncorderT1!",
    "Email": "{{enc_t_email}}"
  }
}

script:post-response {
  const data = res.getBody();
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("Token recibido", function() { expect(data).to.have.property("token"); });
  test("ID de usuario", function() { expect(data.user).to.have.property("id"); });
  if (data.user && data.user.id) bru.setEnvVar("enc_t_user_id", data.user.id);
  if (data.user && data.user.username) bru.setEnvVar("enc_t_username", data.user.username);
  bru.setEnvVar("enc_t_password", "EncorderT1!");
}

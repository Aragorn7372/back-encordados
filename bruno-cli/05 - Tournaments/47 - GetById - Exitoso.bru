meta {
  name: 47 - GetById - Exitoso
  type: http
  seq: 47
}

get {
  url: {{api-url}}/api/Cuerdas/{{cuerda_a_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_t_owner}}
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Tiene id", function() { expect(data).to.have.property("id"); });
  test("Modelo coincide", function() { expect(data.modelo).to.equal("AluPower125"); });
}

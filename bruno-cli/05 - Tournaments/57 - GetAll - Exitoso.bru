meta {
  name: 57 - GetAll - Exitoso
  type: http
  seq: 57
}

get {
  url: {{api-url}}/api/Purchased
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_encorder}}
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Es pagina", function() { expect(data).to.have.property("content"); });
  test("Tiene elementos", function() { expect(data.totalElements).to.be.at.least(1); });
}

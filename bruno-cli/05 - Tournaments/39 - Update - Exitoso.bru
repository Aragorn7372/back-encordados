meta {
  name: 39 - Update - Exitoso
  type: http
  seq: 38
}

script:pre-request {
  req.setBody("Marca=Babolat&Modelo=Syntronic+BTS&Stock=5&Precio=12.50&Type=Grip");
  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
}

put {
  url: {{api-url}}/api/Materials/{{material_a_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_t_owner}}
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Modelo actualizado", function() { expect(data.modelo).to.equal("Syntronic BTS"); });
}

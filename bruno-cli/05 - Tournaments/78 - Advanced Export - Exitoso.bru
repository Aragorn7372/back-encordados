meta {
  name: 78 - Advanced Export - Exitoso
  type: http
  seq: 78
}

get {
  url: {{api-url}}/api/excel/advanced/export?tournamentId={{tournament_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_t_owner}}
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Archivo binario", function() { expect(data).to.not.be.empty; });
}
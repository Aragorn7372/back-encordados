meta {
  name: 09 - Login Tournament Owner
  type: http
  seq: 9
}

post {
  url: {{api-url}}/api/Auth/signin
  body: json
  auth: inherit
}

body:json {
  {
    "Username": "{{t_own_username}}",
    "Password": "{{t_own_password}}"
  }
}

script:post-response {
  const data = res.getBody();
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("Token recibido", function() { expect(data).to.have.property("token"); });
  test("Rol OWNER", function() { expect(data.user.role).to.equal("OWNER"); });
  if (data.token) bru.setEnvVar("token_t_owner", data.token);
}

meta {
  name: 04 - Eliminar tmp2
  type: http
  seq: 4
}

delete {
  url: {{api-url}}/api/User/{{tmp2_user_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_admin}}
}

script:post-response {
  test("Status 204", function() { expect(res.getStatus()).to.equal(204); });
  bru.deleteEnvVar("tmp2_user_id");
  bru.deleteEnvVar("tmp2_token");
  bru.deleteEnvVar("tmp2_username");
  bru.deleteEnvVar("tmp2_password");
}
